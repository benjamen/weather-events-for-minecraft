{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "wx:leaf",
      "basic_render_parameters": { "material": "particles_alpha", "texture": "textures/particle/wx_leaf" }
    },
    "components": {
      "minecraft:emitter_rate_instant": { "num_particles": 1 },
      "minecraft:emitter_lifetime_once": { "active_time": 1 },
      "minecraft:emitter_shape_point": { "direction": ["variable.dir_x", "variable.dir_y", "variable.dir_z"] },
      "minecraft:particle_lifetime_expression": { "max_lifetime": "variable.life" },
      "minecraft:particle_initial_speed": "variable.speed",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": ["variable.dir_x * 1.5", "-0.7 + Math.sin(variable.particle_age * 400) * 0.9", "variable.dir_z * 1.5"],
        "linear_drag_coefficient": 0.6
      },
      "minecraft:particle_appearance_billboard": {
        "size": [0.07, 0.07],
        "facing_camera_mode": "rotate_xyz",
        "uv": { "texture_width": 8, "texture_height": 8, "uv": [0, 0], "uv_size": [8, 8] }
      },
      "minecraft:particle_appearance_tinting": {
        "color": { "gradient": { "0.0": "#FFFFFFFF", "0.85": "#FFFFFFFF", "1.0": "#00FFFFFF" }, "interpolant": "v.particle_age / v.particle_lifetime" }
      },
      "minecraft:particle_expire_if_in_blocks": ["minecraft:water", "minecraft:lava"]
    }
  }
}
